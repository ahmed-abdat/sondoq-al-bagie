# Copy to .env.local for local dev. Names only: never put real values in this file.

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Never prefix with NEXT_PUBLIC_. Set in Vercel, not needed for local dev.
# SUPABASE_SECRET_KEY=sb_secret_xxx

# Vercel sets this for cron requests; /api/keepalive and /api/backup reject other callers when set.
# CRON_SECRET=

# Public address printed on shared reports and in WhatsApp texts (production URL).
# Default when unset: https://${VERCEL_PROJECT_PRODUCTION_URL}, else https://baqie.vercel.app
# (next.config.ts).
# NEXT_PUBLIC_SITE_URL=

# Web Push for the committee (new payment waiting for confirmation). Without these three, push
# is off: the switch says notifications are not supported, and nothing is sent
# (src/lib/push/send.ts, src/lib/push.ts).
# Generate a pair with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=            (server only, never NEXT_PUBLIC_)
# VAPID_SUBJECT=mailto:you@example.com

# Fictional data + demo committee (writes simulated in the browser). For screenshots, e2e and
# previews; ignored on production (src/components/app/demo.ts).
# SONDOQ_FIXTURES=1
